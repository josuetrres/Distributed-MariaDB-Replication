# Direcciones IP LAN de los 3 dispositivos físicos en la red local
# Modificar con las IPs reales de cada máquina (ej. 192.168.1.50, 192.168.1.51, 192.168.1.52)
PC1_IP=192.168.1.93
PC2_IP=192.168.1.8
PC3_IP=192.168.1.30

# Credenciales de Base de Datos MariaDB
DB_NAME=banco_acid_db
DB_USER=banco_user
DB_PASSWORD=banco_pass_segura
DB_ROOT_PASSWORD=root_pass_segura

# Credenciales para el usuario de Replicación MariaDB GTID
REPL_USER=repl_user
REPL_PASSWORD=repl_pass_segura

# Puertos de Servicios en la Red LAN
NGINX_PORT=80
API1_PORT=8081
API2_PORT=8082
API3_PORT=8083
MARIADB_PORT=3306
ADMINER_PORT=8080
